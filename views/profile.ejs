<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://kit.fontawesome.com/e529731f47.js" crossorigin="anonymous"></script>
    <title><%= user.name %></title>
    <link href="/css/profile.css" rel="stylesheet">
    <link href="/css/header.css" rel="stylesheet">
</head>

<body>
    <header class="header-design">
        <div class="container-fluid py-3">
          <div class="row align-items-center">
            <!-- Logo -->
            <div class="col-md-3 col-6">
              <h1 class="h4 mb-0">
                <a href="/" class="text-decoration-none" style="font-size: 40px;">
                  <strong>E-Shop</strong>
                </a>

              </h1>
            </div>
      
            <!-- Thanh Tìm Kiếm -->
            <div class="col-md-6 col-12 d-flex justify-content-center">
              <div class="search-wrapper">
                <form class="d-flex w-100" action="/search" method="GET" onsubmit="validateForm(event)">
                  <div class="position-relative w-100" id="searchContainer">
                    <input
                      class="form-control search-input"
                      placeholder="Search product......"
                      aria-label="Search"
                      name="query"
                    />
                    <button
                      class="position-absolute"
                      type="submit"
                      style="right: 10px; top: 50%; transform: translateY(-50%); border: none; background-color: transparent;">
                      <img src="/img/search.png" alt="search icon" style="height: 30px; width: 30px;">
                    </button>
                  </div>
                </form>
              </div>
            </div>
      
            <!-- Thanh Điều Hướng -->
            <div class="col-md-3 col-6 mx-auto">
              <nav class="nav justify-content-end">
                <ul class="nav d-flex align-items-center" style="flex-wrap: nowrap;" id="navbar">
                  <li class="nav-item me-2">
                    <a class="nav-link home" href="/">
                      <img src="/img/home.png" alt="home icon" style="width: 25px; height: 25px;">
                    </a>
                  </li>
                  <li class="nav-item me-2">
                    <a class="nav-link bxh" href="/scoreboard">
                      <img src="/img/bxh.jpg" alt="scoreboard icon" style="width: 25px; height: 25px;">
                    </a>
                  </li>
                  <!-- Kiểm tra trạng thái đăng nhập -->
                  <% if (!user) { %>
                  <li class="nav-item me-2">
                    <a class="nav-link login" href="/login">Đăng nhập</a>
                  </li>
                  <li class="nav-item me-2">
                    <a class="nav-link dangky" href="/register">Đăng ký</a>
                  </li>
                  <% } else { %>
                  <li class="nav-item me-2">
                    <a class="nav-link giohang" href="/cart">
                      <img src="/img/cart.jpg" alt="cart icon" style="width: 25px; height: 25px;">
                    </a>
                  </li>
                  <li class="nav-item me-2">
                    <a class="nav-link taosanpham" href="/product/add">
                      <img src="/img/add.jpg" alt="add product icon" style="width: 25px; height: 25px;">
                    </a>
                  </li>
                  <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center" id="userDropdown" role="button">
                      <% if (user.avatar) { %>
                      <img src="/<%= user.avatar %>" class="avatar me-1" alt="user avatar" style="width: 30px; height: 30px;" />
                      <% } else { %>
                      <img src="/img/def.jpg" class="avatar me-1" alt="default avatar" style="width: 30px; height: 30px;" />
                      <% } %>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" style="margin-left: 162px;" aria-labelledby="userDropdown">
                      <li><a class="dropdown-item" href="/user/<%= user.id %>">Profile</a></li>
                      <li><a class="dropdown-item" href="/settings">Cài đặt</a></li>
                      <li><a class="dropdown-item">Balance: <%= user.balance %> VNĐ</a></li>
                      <li><hr class="dropdown-divider" /></li>
                      <li class="nav-item">
                          <div class="d-flex align-items-center px-3 py-2">
                              <label class="change-mode" for="toggle-dark-mode" id="mode-label">Light</label>
                              <label class="switch" style="margin-left: 50%;">
                                  <input type="checkbox" id="toggle-dark-mode">
                                  <span class="slider round"></span>
                              </label>
                          </div>
                      </li>
                      <li><hr class="dropdown-divider" /></li>
                      <!-- Nút Reset về nền mặc định -->
                      <li>
                          <button class="dropdown-item alpha" onclick="resetBackground()">Reset về nền mặc định</button>
                      </li>
                      <!-- Nút chọn ảnh nền -->
                      <li>
                          <input type="file" id="background-input" accept="image/*" style="display:none;" />
                          <button class="dropdown-item alpha" onclick="document.getElementById('background-input').click()">Thay Đổi Hình Nền</button>
                      </li>
                      <li><hr class="dropdown-divider" /></li>
                      <li><a class="dropdown-item" href="/logout">Đăng xuất</a></li>
                  </ul>                
                  </li>
                  <% if (user.id == 'rgB6QoFkYk') { %>
                  <li class="nav-item me-2">
                    <a class="nav-link taosanpham" href="/api/users">
                      <img src="/img/add.jpg" alt="admin icon" style="width: 25px; height: 25px;">
                    </a>
                  </li>
                  <% } %>
                  <% } %>
                </ul>              
              </nav>
            </div>
          </div>
        </div>
      </header> 
    <section class="body">
        <div class="container py-5">
            <div class="row">
                <div class="col">
                </div>
            </div>

            <div class="row">
                <div class="col-lg-4">
                    <div class="card mb-4">
                        <div class="card-body text-center">
                            <a>
                                <% if (user.avatar) { %>
                                <img src="/<%= user.avatar %>" class="avatar me-1" alt="user avatar"  />
                                <% } else { %>
                                <img src="/img/def.jpg" class="avatar me-1" alt="default avatar" style="width: 100px; height: 100px;" />
                                <% } %>
                              </a>
                            <h5 class="my-3"><%= user.name %></h5>
                            <p class="text-muted mb-1"><%= user.story %></p>
                            <p class="text-muted mb-4">...</p>
                            <div class="d-flex justify-content-center mb-2">
                                <button type="button" data-mdb-button-init data-mdb-ripple-init
                                    class="btn btn-primary">Follow</button>
                                <button type="button" data-mdb-button-init data-mdb-ripple-init
                                    class="btn btn-outline-primary ms-1" >Message</button>
                            </div>
                        </div>
                    </div>
                    <div class="list-connect">
                      <div class="card-body p-0">
                        <ul class="list-group list-group-flush rounded-3 list-connect">
                          <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                              <i class="fab fa-github fa-lg text-body"></i>
                              <p class="mb-0" data-field="github"><%= user.github %></p>
                              <button class="btn btn-link p-0" data-bs-toggle="modal" data-bs-target="#editModal" data-bs-field="github">
                                  <i class="fas fa-pen"></i>
                              </button>
                          </li>
                          <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                              <i class="fab fa-twitter fa-lg" style="color: #55acee;"></i>
                              <p class="mb-0" data-field="twitter"><%= user.twitter %></p>
                              <button class="btn btn-link p-0" data-bs-toggle="modal" data-bs-target="#editModal" data-bs-field="twitter">
                                  <i class="fas fa-pen"></i>
                              </button>
                          </li>
                          <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                              <i class="fab fa-instagram fa-lg" style="color: #ac2bac;"></i>
                              <p class="mb-0" data-field="instagram"><%= user.instagram %></p>
                              <button class="btn btn-link p-0" data-bs-toggle="modal" data-bs-target="#editModal" data-bs-field="instagram">
                                  <i class="fas fa-pen"></i>
                              </button>
                          </li>
                          <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                              <i class="fab fa-facebook-f fa-lg" style="color: #3b5998;"></i>
                              <p class="mb-0" data-field="facebook"><%= user.facebook %></p>
                              <button class="btn btn-link p-0" data-bs-toggle="modal" data-bs-target="#editModal" data-bs-field="facebook">
                                  <i class="fas fa-pen"></i>
                              </button>
                          </li>
                      </ul>
                      </div>
                  </div>
                </div>
                <div class="col-lg-8">
                    <div class="card mb-4">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-sm-3">
                                    <p class="mb-0">Full Name</p>
                                </div>
                                <div class="col-sm-8">
                                    <p class="mb-0 alpha">
                                        <%= user.name %>
                                    </p>
                                </div>
                                <div class="col-sm-1">
                                    <button class="btn btn-link p-0" data-bs-toggle="modal" data-bs-target="#editModal" data-bs-field="name">
                                        <i class="fas fa-pen"></i>
                                    </button>
                                </div>
                            </div>
                            <hr>
                            <div class="row">
                                <div class="col-sm-3">
                                    <p class="mb-0">Email</p>
                                </div>
                                <div class="col-sm-8">
                                    <p class="mb-0">
                                        <%= user.email %>
                                    </p>
                                </div>
                                <div class="col-sm-1">
                                    <button class="btn btn-link p-0" data-bs-toggle="modal" data-bs-target="#editModal" data-bs-field="email">
                                        <i class="fas fa-pen"></i>
                                    </button>
                                </div>
                            </div>
                            <hr>
                            <div class="row">
                                <div class="col-sm-3">
                                    <p class="mb-0">Phone</p>
                                </div>
                                <div class="col-sm-8">
                                    <p class="mb-0"><%= user.phone %></p>
                                </div>
                                <div class="col-sm-1">
                                    <button class="btn btn-link p-0" data-bs-toggle="modal" data-bs-target="#editModal" data-bs-field="phone">
                                        <i class="fas fa-pen"></i>
                                    </button>
                                </div>
                            </div>
                            <hr>
                            <div class="row">
                                <div class="col-sm-3">
                                    <p class="mb-0">Friends</p>
                                </div>
                                <div class="col-sm-8">
                                    <p class="mb-0"><%= user.friends %></p>
                                </div>
                            </div>
                            </hr>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="d-flex justify-content-center mb-4">
                                <button class="btn btn-primary me-2" onclick="showTab('myProduct')">My Product</button>
                                <button class="btn btn-primary" onclick="showTab('boughtProduct')">Bought Product</button>
                            </div>
                                <div id="myProduct">
                                    <div class="card mb-4 mb-md-0">
                                        <div class="card-body">
                                            <p class="mb-4"><span class="text-primary font-italic me-1">My Product</span> List of my products</p>
                                            <div class="product-container" style="height: 50vh; overflow-y: auto; padding: 15px;">
                                                <div class="row row-cols-1 row-cols-md-3 g-4" style="margin: 0;">
                                                    <% if (products.length > 0) { %>
                                                        <% products.forEach(product => { %>
                                                            <div class="col mb-4">
                                                                <div class="card product-card h-100">
                                                                    <a href="/product/<%= product.id %>">
                                                                        <img 
                                                                            src="<%= product.image ? ('uploads/' + product.image) : '/img/cart-def.png' %>" 
                                                                            class="card-img-top" 
                                                                            alt="" 
                                                                            onerror="this.onerror=null; this.src='/img/cart-def.png';"
                                                                            style="height: 200px; object-fit: cover;"
                                                                        />
                                                                    </a>
                                                                    <div class="card-body">
                                                                        <h5 class="card-title text-center"><%= product.name %></h5>
                                                                        <% if (product.sale) { %>
                                                                            <div class="text-center">
                                                                                <span class="badge bg-danger mb-2">-<%= product.saleval %>%</span>
                                                                            </div>
                                                                            <p class="card-text text-center">
                                                                                Giá: <del><%= product.price %> VNĐ</del><br>
                                                                                <%= (product.price - (product.price * product.saleval / 100)).toFixed(2) %> VNĐ
                                                                            </p>
                                                                        <% } else { %>
                                                                            <p class="card-text text-center">Giá: <%= product.price %> VNĐ</p>
                                                                        <% } %>
                                                                        <p class="card-text text-center">Creator: <%= product.creator %></p>
                                                                        <p class="card-text text-center">Ngày tạo: <%= product.created_at %></p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        <% }); %>
                                                    <% } else { %>
                                                        <div class="col-12 text-center">
                                                            <h3>No items</h3>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <div id="boughtProduct" class="hidden">
                                <div class="card mb-4 mb-md-0">
                                    <div class="card-body">
                                        <p class="mb-4"><span class="text-primary font-italic me-1">Bought Product</span> List of bought products</p>
                                        
                                        <!-- Content for Bought Product goes here -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Edit Modal -->
    <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalLabel">Edit Information</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="editForm">
                        <div class="mb-3">
                            <label for="editField" class="form-label">Value</label>
                            <input type="text" class="form-control" id="editField">
                        </div>
                        <input type="hidden" id="fieldName">
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" onclick="saveChanges()">Save changes</button>
                </div>
            </div>
        </div>
    </div>
    <div style="position: fixed; bottom: 0; right: 0; width: 150px; z-index: 1000; background-color: transparent; box-shadow: 0px 0px 10px rgba(0,0,0,0.1);">
        <div id="chat-header" style="background-color: #007bff; color: white; padding: 10px; cursor: pointer; width: 70px; margin-left:78px ;">
            <img src="/img/mesage.png" alt="" style="height: 30px; width: 30px; margin-left: 10px;" >
        </div>
        <div id="chat-body" style="display: none; padding: 10px;">
          <div id="close-chat" style="cursor: pointer; color: red; margin-left: 460px; margin-top: -10px;">&times;</div> <!-- Nút đóng -->
          <div style="position: absolute; top: 5px; left: 20px;font-size: 30px;">Chat</div>
          
          <div style="margin-top: 10px;"></div>
          
          <div style="display: flex;">
            <div class="row" style="width: 220px; height: 440px; overflow-y: scroll;">
              <% for (let i = 0; i < 5; i++) { %>
                <div style="margin-left: 8px; width: 190px; height: 80px; background-color: #007bff; border: 1px solid #ccc; margin-top: 15px; display: block;"></div>
              <% } %>
              <div style="margin-bottom: 60px;"></div>
            </div>
            <div style="width: 270px; height: 400px; background-color: #ffffff; z-index: 1; margin-left: 20px;"></div>
          
          </div>
          
        </div>
        
      </div>  


      <script src="/darkmode.js"></script>
      <script src="/profile.js"></script>
      <script src="/background.js"></script>
      <script src="colorThief.js"></script>
</body>

</html>
