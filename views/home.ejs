<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link rel="shortcut icon" href="#" />
    <link rel="stylesheet" href="css/home.css">
    <link rel="stylesheet" href="css/header.css">
  </head>

  <body>
    <header class="header-design">
      <div class="container-fluid py-3">
        <div class="row align-items-center">
          <!-- Logo -->
          <div class="col-md-3 col-6">
            <h1 class="h4 mb-0">
              <a href="/" class="text-decoration-none" style="font-size: 40px;">
                <strong>E-Shop</strong>
              </a>
            </h1>
          </div>
    
          <!-- Thanh Tìm Kiếm -->
          <div class="col-md-6 col-12 d-flex justify-content-center">
            <div class="search-wrapper">
              <form class="d-flex w-100" action="/search" method="GET" onsubmit="validateForm(event)">
                <div class="position-relative w-100" id="searchContainer">
                  <input
                    class="form-control search-input"
                    placeholder="Search product......"
                    aria-label="Search"
                    name="query"
                  />
                  <button
                    class="position-absolute"
                    type="submit"
                    style="right: 10px; top: 50%; transform: translateY(-50%); border: none; background-color: transparent;">
                    <img src="img/search.png" alt="search icon" style="height: 30px; width: 30px;">
                  </button>
                </div>
              </form>
            </div>
          </div>
    
          <!-- Thanh Điều Hướng -->
          <div class="col-md-3 col-6 mx-auto">
            <nav class="nav justify-content-end">
              <ul class="nav d-flex align-items-center" style="flex-wrap: nowrap;" id="navbar">
                <li class="nav-item me-2">
                  <a class="nav-link home" href="/">
                    <img src="/img/home.png" alt="home icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <li class="nav-item me-2">
                  <a class="nav-link bxh" href="/scoreboard">
                    <img src="/img/bxh.jpg" alt="scoreboard icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <!-- Kiểm tra trạng thái đăng nhập -->
                <% if (!user) { %>
                <li class="nav-item me-2">
                  <a class="nav-link login" href="/login">Đăng nhập</a>
                </li>
                <li class="nav-item me-2">
                  <a class="nav-link dangky" href="/register">Đăng ký</a>
                </li>
                <% } else { %>
                <li class="nav-item me-2">
                  <a class="nav-link giohang" href="/cart">
                    <img src="/img/cart.jpg" alt="cart icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <li class="nav-item me-2">
                  <a class="nav-link taosanpham" href="/product/add">
                    <img src="/img/add.jpg" alt="add product icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <li class="nav-item dropdown">
                  <a class="nav-link dropdown-toggle d-flex align-items-center" id="userDropdown" role="button">
                    <% if (user.avatar) { %>
                    <img src="/<%= user.avatar %>" class="avatar me-1" alt="user avatar" style="width: 30px; height: 30px;" />
                    <% } else { %>
                    <img src="./img/def.jpg" class="avatar me-1" alt="default avatar" style="width: 30px; height: 30px;" />
                    <% } %>
                  </a>
                  <ul class="dropdown-menu dropdown-menu-end" style="margin-left: -270%;" aria-labelledby="userDropdown">
                    <li><a class="dropdown-item" href="/user/<%= user.id %>">Profile</a></li>
                    <li><a class="dropdown-item" href="/settings">Cài đặt</a></li>
                    <li><a class="dropdown-item">Balance: <%= user.balance %> VNĐ</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li class="nav-item">
                        <div class="d-flex align-items-center px-3 py-2">
                            <label class="change-mode" for="toggle-dark-mode" id="mode-label">Light</label>
                            <label class="switch" style="margin-left: 50%;">
                                <input type="checkbox" id="toggle-dark-mode">
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <!-- Nút Reset về nền mặc định -->
                    <li>
                        <button class="dropdown-item alpha" onclick="resetBackground()">Reset về nền mặc định</button>
                    </li>
                    <!-- Nút chọn ảnh nền -->
                    <li>
                        <input type="file" id="background-input" accept="image/*" style="display:none;" />
                        <button class="dropdown-item alpha" onclick="document.getElementById('background-input').click()">Thay Đổi Hình Nền</button>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" href="/logout">Đăng xuất</a></li>
                </ul>                
                </li>
                <% if (user.id == 'rgB6QoFkYk') { %>
                <li class="nav-item me-2">
                  <a class="nav-link taosanpham" href="/api/users">
                    <img src="/img/add.jpg" alt="admin icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <% } %>
                <% } %>
              </ul>              
            </nav>
          </div>
        </div>
      </div>
    </header>   
    <main>
      <div class="container my-5">
        <div id="carouselExampleControls" class="carousel slide">
          <div class="carousel-inner">
            <div class="carousel-item active">
              <a href="/scoreboard"
                ><img
                  class="d-block w-100"
                  src="/img/clear.png"
                  alt="First slide"
              /></a>
            </div>
            <div class="carousel-item">
              <img
                class="d-block w-100"
                src="/img/duolingo.png"
                alt="Second slide"
              />
            </div>
            <div class="carousel-item">
              <img
                class="d-block w-100"
                src="/img/head-shoulders.png"
                alt="Third slide"
              />
            </div>
          </div>
          <a
            class="carousel-control-prev"
            href="#carouselExampleControls"
            role="button"
            data-bs-slide="prev"
          >
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </a>
          <a
            class="carousel-control-next"
            href="#carouselExampleControls"
            role="button"
            data-bs-slide="next"
          >
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </a>
        </div>
        <div class="row mt-5">
          <div class="col">
            <h2 class="section-title text-center">Sản phẩm nổi bật</h2><br>
            <div class="row">
              <div class="col-md-6">
                <div class="card mb-3">
                  <h2 style="text-align: center;">Sản phẩm</h2>
                  <div class="card-body">
                    <h3 class="card-title">Tên sản phẩm</h3>
                    <p class="card-text">Mô tả ngắn về sản phẩm.</p>
                    <p class="card-text">Giá: 1,000,000 VND</p>
                    <a href="/hotproduct" class="btn btn-primary center-text" >Danh sách</a>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="card mb-3">
                  <h2 style="text-align: center;">Khuyến mãi</h2>
                  <div class="card-body">
                    <h3 class="card-title">Tên chương trình khuyến mãi</h3>
                    <p class="card-text">Chi tiết chương trình khuyến mãi.</p>
                    <p class="card-text">Giảm giá: 20%</p>
                    <a href="/salelist" class="btn btn-danger center-text">Xem chi tiết</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="row mt-5">
          <div class="col">
            <h2 class="section-title text-center">Danh mục sản phẩm</h2>
            <div class="row row-cols-1 row-cols-md-5 g-4">
              <% products.forEach(product => { %>
                <% if (product.quantity > 0) { %>
                  <div class="col-6 col-md-4 the-product" style="background-color: transparent;"> <!-- Use col-6 for 2 items on small screens -->
                    <div class="card product-card">
                      <a href="/product/<%= product.id %>">
                        <img 
                          src="<%= product.image ? ('uploads/' + product.image) : '/img/cart-def.png' %>" 
                          class="card-img-top" 
                          alt="" 
                          onerror="this.onerror=null; this.src='/img/cart-def.png';"
                        />
                      </a>
                      <div class="card-body">
                        <h4 class="card-title text-center"><%= product.name %></h4> <!-- Use text-center class -->
                        <% if (product.saleval) { %>
                          <center><span class="badge bg-danger ms-2" style="margin-bottom: 10px;">-<%= product.saleval %>%</span></center>
                          <p class="card-text" style="margin-bottom: 4px;">
                            Giá: <%= formatCurrency((product.price - (product.price * product.saleval / 100).toFixed(0))) %> VNĐ
                            <del> <%= formatCurrency(product.price) %> </del>
                          </p>
                          <div style="padding-left: 1px; padding-bottom: 10px">
                            <div class="creator-day" style="margin-top: -0px;">
                              <p class="card-text" style="margin-bottom: 3px">
                                Creator: <%= product.creator %>
                              </p>
                              <p class="card-text" style="margin-top: 3px">
                                Ngày tạo: <%= product.formatted_date %>
                              </p>
                            </div>
                            <div class="d-flex mt-3">
                              <a
                                href="/product/<%= product.id %>"
                                class="btn btn-success rounded">
                                <div>
                                  Thông tin
                                </div>
                                <div>
                                  sản phẩm
                                </div>
                              </a>
                              <a style="margin-left: -20px;">
                                <button
                                  type="button"
                                  class="btn btn-primary rounded addToCartBtn"
                                  data-product-id="<%= product.id %>"
                                >
                                  Thêm vào giỏ
                                </button>
                              </a>
                            </div>
                          </div>
                        <% } else { %>
                          <div style="margin-top: 40px;">
                            <p class="card-text">Giá: <%= formatCurrency(product.price) %> VNĐ</p>
                          </div>
                          <div style="padding-left: -10px; padding-bottom: 10px">
                            <div class="creator-day" style="margin-top: 1px;">
                              <p class="card-text" style="margin-bottom: -2px">
                                Creator: <%= product.creator %>
                              </p>
                              <p class="card-text" style="margin-top: 3px">
                                Ngày tạo: <%= product.formatted_date %>
                              </p>
                            </div>
                            <div class="d-flex mt-3">
                              <a
                                href="/product/<%= product.id %>"
                                class="btn btn-success rounded viewProductBtn"
                                data-product-id="<%= product.id %>"
                                data-product-score="5"  
                              >
                                <div>
                                  Thông tin
                                </div>
                                <div>
                                  sản phẩm
                                </div>
                              </a>
                              <a style="margin-left: -20px;">
                                <button
                                  type="button"
                                  class="btn btn-primary rounded addToCartBtn"
                                  data-product-id="<%= product.id %>"
                                >
                                  Thêm vào giỏ
                                </button>
                              </a>
                            </div>
                          </div>
                        <% } %>
                      </div>
                    </div>
                  </div>
                <% } %>
              <% }); %>              
            </div>
          </div>
        </div>
        <footer class="py-4 mt-5">
          <div class="container">
            <div class="text-center custom">&copy; 2024 E-Shop</div>
            <div class="text-center mt-3">
              <a href="#" class="text-decoration-none mx-2 custom"
                >Chính sách bảo mật</a>
              <a href="#" class="text-decoration-none mx-2 custom"
                >Điều khoản sử dụng</a>
            </div>
          </div>
        </footer>
      </div>
    </main>
    

    <div
      class="modal fade"
      id="addToCartModal"
      tabindex="-1"
      aria-labelledby="addToCartModalLabel"
      aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="addToCartModalLabel">
              Xác nhận thêm vào giỏ hàng
            </h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body">
            Bạn có chắc chắn muốn thêm sản phẩm này vào giỏ hàng?
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-primary confirmAddToCartBtn">
              Thêm vào giỏ
            </button>
          </div>
        </div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/color-thief/2.3.0/color-thief.umd.js"></script>
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <script src="colorThief.js"></script>
    <script src="darkmode.js"></script> 
    <script src="add-cart.js"></script>
    <script src="scoreboard.js"></script>
    <script src="search.js"></script>
    <script src="background.js"></script>
   </body>
</html>
