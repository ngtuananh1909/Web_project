<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Settings</title>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <link rel="stylesheet" href="/css/setting.css">
  <link rel="stylesheet" href="/css/header.css">
  <body>
    <header class="header-design">
      <div class="container-fluid py-3">
        <div class="row align-items-center">
          <!-- Logo -->
          <div class="col-md-3 col-6">
            <h1 class="h4 mb-0">
              <a href="/" class="text-decoration-none" style="font-size: 40px;">
                <strong>E-Shop</strong>
              </a>
            </h1>
          </div>
    
          <!-- Thanh Tìm Kiếm -->
          <div class="col-md-6 col-12 d-flex justify-content-center">
            <div class="search-wrapper">
              <form class="d-flex w-100" action="/search" method="GET" onsubmit="validateForm(event)">
                <div class="position-relative w-100" id="searchContainer">
                  <input
                    class="form-control search-input"
                    placeholder="Search product......"
                    aria-label="Search"
                    name="query"
                  />
                  <button
                    class="position-absolute"
                    type="submit"
                    style="right: 10px; top: 50%; transform: translateY(-50%); border: none; background-color: transparent;">
                    <img src="img/search.png" alt="search icon" style="height: 30px; width: 30px;">
                  </button>
                </div>
              </form>
            </div>
          </div>
    
          <!-- Thanh Điều Hướng -->
          <div class="col-md-3 col-6 mx-auto">
            <nav class="nav justify-content-end">
              <ul class="nav d-flex align-items-center" style="flex-wrap: nowrap;" id="navbar">
                <li class="nav-item me-2">
                  <a class="nav-link home" href="/">
                    <img src="/img/home.png" alt="home icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <li class="nav-item me-2">
                  <a class="nav-link bxh" href="/scoreboard">
                    <img src="/img/bxh.jpg" alt="scoreboard icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <!-- Kiểm tra trạng thái đăng nhập -->
                <% if (!user) { %>
                <li class="nav-item me-2">
                  <a class="nav-link login" href="/login">Đăng nhập</a>
                </li>
                <li class="nav-item me-2">
                  <a class="nav-link dangky" href="/register">Đăng ký</a>
                </li>
                <% } else { %>
                <li class="nav-item me-2">
                  <a class="nav-link giohang" href="/cart">
                    <img src="/img/cart.jpg" alt="cart icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <li class="nav-item me-2">
                  <a class="nav-link taosanpham" href="/product/add">
                    <img src="/img/add.jpg" alt="add product icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <li class="nav-item me-2">
                  <a class="nav-link donhang" href="/product/add">
                    <img src="/img/donhang.png" alt="donhang icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <li class="nav-item dropdown">
                  <a class="nav-link dropdown-toggle d-flex align-items-center" id="userDropdown" role="button">
                    <% if (user.avatar) { %>
                    <img src="/<%= user.avatar %>" class="avatar me-1" alt="user avatar" style="width: 30px; height: 30px;" />
                    <% } else { %>
                    <img src="./img/def.jpg" class="avatar me-1" alt="default avatar" style="width: 30px; height: 30px;" />
                    <% } %>
                  </a>
                  <ul class="dropdown-menu dropdown-menu-end" style="margin-left: -270%;" aria-labelledby="userDropdown">
                    <li><a class="dropdown-item" href="/user/<%= user.id %>">Profile</a></li>
                    <li><a class="dropdown-item" href="/settings">Cài đặt</a></li>
                    <li><a class="dropdown-item">Balance: <%= user.balance %> VNĐ</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li class="nav-item">
                        <div class="d-flex align-items-center px-3 py-2">
                            <label class="change-mode" for="toggle-dark-mode" id="mode-label">Light</label>
                            <label class="switch" style="margin-left: 50%;">
                                <input type="checkbox" id="toggle-dark-mode">
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <!-- Nút Reset về nền mặc định -->
                    <li>
                        <button class="dropdown-item alpha" onclick="resetBackground()">Reset về nền mặc định</button>
                    </li>
                    <!-- Nút chọn ảnh nền -->
                    <li>
                        <input type="file" id="background-input" accept="image/*" style="display:none;" />
                        <button class="dropdown-item alpha" onclick="document.getElementById('background-input').click()">Thay Đổi Hình Nền</button>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" href="/logout">Đăng xuất</a></li>
                </ul>                
                </li>
                <% if (user.id == 'rgB6QoFkYk') { %>
                <li class="nav-item me-2">
                  <a class="nav-link taosanpham" href="/api/users">
                    <img src="/img/add.jpg" alt="admin icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <% } %>
                <% } %>
              </ul>              
            </nav>
          </div>
        </div>
      </div>
    </header>  

    <div class="body">
      <h1 style="text-align: center;"><strong>User Settings</strong></h1>
      <div class="setting" style="margin-left: 220px;">
            <div class="edit-name" style="margin-left: 400px;">
              <form
              id="settingsForm"
              action="/auth/UserUpdate"
              method="POST"
              enctype="multipart/form-data"
              style="width: 40%;"
              >
              <div class="form-group alpha">
                <label class="alpha" for="name" style="margin-right: -65px;">Name:</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  value="<%= user.name %>"
                  required
                  readonly
                >
                <button class="button-select" type="button" onclick="toggleEditMode('name')">Change Your name</button>
              </div>
              <div class="form-group">
                <label for="avatar">Avatar</label>
                <img
                  src="<%= user.avatar %>"
                  alt="User Avatar"
                  width="100"
                  height="100"
                />
                <input type="file" id="avatar" name="avatar" />
              </div>
              </form>
            </div>
              <div class="edit-name" style="margin-left: 400px;">
                <div class="form-group" >
                  <form
                  id="settingsForm"
                  action="/auth/UserUpdate"
                  method="POST"
                  enctype="multipart/form-data"
                  style="width: 40%;"
                  >
                  <label class="alpha" for="password" style="margin-right: -70px;">Password:</label>
                  <input
                    type="password"
                    id="password"
                    name="password"
                    value="********"
                    readonly
                    style="width: 59%;"
                  >
                  </form>
                  <button class="button-select" style="margin-left: -150px; margin-bottom: 0px;" type="button" onclick="togglePasswordCheck()">Change Password</button>
                </div>
              </div>
              <div class="form-group password-check edit-name" id="passwordCheck" style="margin-left: 488px;">
                <form
                  id="settingsForm"
                  action="/auth/UserUpdate"
                  method="POST"
                  enctype="multipart/form-data"
                  style="width: 40%;"
                  >
                <input
                  type="password"
                  id="password-confirm"
                  name="password_confirm"
                  placeholder="Enter your new password"
                  style="width: 62%;"
                />
                </form>
                <button type="button"  onclick="confirmPassword()" style="margin-left: -200px;">Confirm</button>
              </div>
              <div class="edit-name" style="margin-left: 400px;">
                <div class="form-group">
                  <form
                    id="settingsForm"
                    action="/auth/UserUpdate"
                    method="POST"
                    enctype="multipart/form-data"
                    style="width: 40%;"
                    >
                  <label class="alpha" for="email">Email:</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    value="<%= user.email %>"
                    required
                    readonly
                    style="width: 60%;margin-left: -80px;"
                  />
                  <button type="button" onclick="toggleEditMode('email')">Change email</button>
                </div>
              </div>
              <div class="form-group" style="margin-left: 390px;">
                <button type="submit">Update Settings</button>
              </div>
              <% if (typeof message !=='undefined' && message) { %>
              <div class="message"><%= message %></div>
              <% } %>
          </div>
      </div>
    <script src="/setting.js"></script>
    <script src="/darkmode.js"></script>
  </body>
</html>
