<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Settings</title>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <link rel="stylesheet" href="/css/setting.css">
  <link rel="stylesheet" href="/css/header.css">
  <body>
    <header class="header-design">
      <div class="container-fluid py-3">
        <div class="row align-items-center">
          <!-- Logo -->
          <div class="col-md-3 col-6">
            <h1 class="h4 mb-0 logo">
                <a href="/" class="text-decoration-none" style="font-size: 40px;" id="logo-text">
                    <strong>E-Shop</strong>
                </a>
            </h1>
          </div>
    
          <!-- Thanh Tìm Kiếm -->
          <div class="col-md-6 col-12 d-flex justify-content-center">
            <div class="search-wrapper">
              <form class="d-flex w-100" action="/search" method="GET" onsubmit="validateForm(event)">
                <div class="position-relative w-100" id="searchContainer">
                  <input
                    class="form-control search-input"
                    placeholder="Search product......"
                    aria-label="Search"
                    name="query"
                  />
                  <button
                    class="position-absolute"
                    type="submit"
                    style="right: 10px; top: 50%; transform: translateY(-50%); border: none; background-color: transparent;">
                    <img src="/img/search.png" alt="search icon" style="height: 30px; width: 30px;">
                  </button>
                </div>
              </form>
            </div>
          </div>
    
          <!-- Thanh Điều Hướng -->
          <div class="col-md-3 col-6 mx-auto">
            <nav class="nav justify-content-end">
              <ul class="nav d-flex align-items-center" style="flex-wrap: nowrap;" id="navbar">
                <li class="nav-item me-2">
                  <a class="nav-link home" href="/">
                    <img src="/img/home.png" alt="home icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <li class="nav-item me-2">
                  <a class="nav-link bxh" href="/scoreboard">
                    <img src="/img/bxh.jpg" alt="scoreboard icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <!-- Kiểm tra trạng thái đăng nhập -->
                <% if (!user) { %>
                <li class="nav-item me-2">
                  <a class="nav-link login" href="/login">Đăng nhập</a>
                </li>
                <li class="nav-item me-2">
                  <a class="nav-link dangky" href="/register">Đăng ký</a>
                </li>
                <% } else { %>
                <li class="nav-item me-2">
                  <a class="nav-link giohang" href="/cart">
                    <img src="/img/cart.jpg" alt="cart icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <li class="nav-item me-2">
                  <a class="nav-link taosanpham" href="/product/add">
                    <img src="/img/add.jpg" alt="add product icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <li class="nav-item me-2">
                  <a class="nav-link donhang" href="/product/add">
                    <img src="/img/donhang.png" alt="donhang icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <li class="nav-item dropdown">
                  <a class="nav-link dropdown-toggle d-flex align-items-center" id="userDropdown" role="button">
                    <% if (user.avatar) { %>
                    <img src="/<%= user.avatar %>" class="avatar me-1" alt="user avatar" style="width: 30px; height: 30px;" />
                    <% } else { %>
                    <img src="/img/def.jpg" class="avatar me-1" alt="default avatar" style="width: 30px; height: 30px;" />
                    <% } %>
                  </a>
                  <ul class="dropdown-menu dropdown-menu-end alpha" style="margin-left: 162px;" aria-labelledby="userDropdown">
                    <li><a class="dropdown-item alpha" href="/user/<%= user.id %>">Profile</a></li>
                    <li><a class="dropdown-item alpha" href="/settings">Cài đặt</a></li>
                    <li><a class="dropdown-item alpha" >Balance: <%= user.balance %> VNĐ</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li class="nav-item">
                        <div class="d-flex align-items-center px-3 py-2">
                            <label class="change-mode" for="toggle-dark-mode" id="mode-label">Light</label>
                            <label class="switch" style="margin-left: 50%;">
                                <input type="checkbox" id="toggle-dark-mode">
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <!-- Nút Reset về nền mặc định -->
                    <li>
                        <button class="dropdown-item alpha" onclick="resetBackground()">Reset về nền mặc định</button>
                    </li>
                    <!-- Nút chọn ảnh nền -->
                    <li>
                        <input type="file" id="background-input" accept="image/*" style="display:none;" />
                        <button class="dropdown-item alpha" onclick="document.getElementById('background-input').click()">Thay Đổi Hình Nền</button>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item alpha" href="/logout">Đăng xuất</a></li>
                </ul>                
                </li>
                <% if (user.id == 'rgB6QoFkYk') { %>
                <li class="nav-item me-2">
                  <a class="nav-link taosanpham" href="/api/users">
                    <img src="/img/add.jpg" alt="admin icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <% } %>
                <% } %>
              </ul>              
            </nav>
          </div>
        </div>
      </div>
    </header>  

    <div class="settings-container">
    <h2 class="settings-title">Account Settings</h2>
    
    <form id="settingsForm" action="/auth/UserUpdate" method="POST" enctype="multipart/form-data">
        <div class="setting-group">
            <label class="setting-label" for="name">Name</label>
            <div class="setting-input-container">
                <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    value="<%= user.name %>" 
                    class="form-control setting-input"
                    required
                    readonly
                    style="flex: 1;"
                >
                <button type="button" class="setting-edit-btn" onclick="toggleEditMode('name')">Edit</button>
            </div>
        </div>

        <!-- Tương tự cho các trường khác -->
        
        <div class="setting-group avatar-section">
            <label class="setting-label">Avatar</label>
            <div class="setting-input-container">
                <img 
                    src="<%= user.avatar ? user.avatar : '/img/def.jpg' %>" 
                    class="avatar-preview"
                >
                <input 
                    type="file" 
                    class="avatar-input" 
                    name="avatar"
                >
            </div>
        </div>
        <!-- Email field -->
            <div class="setting-group">
                <div class="setting-label">
                    <i class="fas fa-envelope"></i> Email
                </div>
                <div class="setting-input-container">
                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="<%= user.email %>"
                        class="setting-input"
                        required
                        readonly
                    >
                    <button 
                        type="button" 
                        class="setting-edit-btn" 
                        onclick="toggleEditMode('email')"
                    >
                        Edit
                    </button>
                </div>
            </div>

            <!-- Phone field -->
            <div class="setting-group">
                <div class="setting-label">
                    <i class="fas fa-phone"></i> Phone
                </div>
                <div class="setting-input-container">
                    <input
                        type="tel"
                        id="phone"
                        name="phone"
                        value="<%= user.phone %>"
                        class="setting-input"
                        required
                        readonly
                    >
                    <button 
                        type="button" 
                        class="setting-edit-btn" 
                        onclick="toggleEditMode('phone')"
                    >
                        Edit
                    </button>
                </div>
            </div>

            <div class="setting-group">
              <div class="setting-label">
                  <i class="fas fa-lock"></i> Password
              </div>
              <div class="setting-input-container position-relative">
                  <input
                      type="password"
                      id="password"
                      name="password"
                      class="setting-input pr-5"
                      readonly
                      placeholder="********"
                  >
                  <img 
                      src="/img/eye2.png" 
                      id="passwordToggleIcon" 
                      class="password-toggle-icon" 
                      onclick="togglePasswordVisibility()"
                  >
                  <button 
                      type="button" 
                      class="setting-edit-btn" 
                      onclick="togglePasswordCheck()"
                  >
                      Edit
                  </button>
              </div>
          </div>
          
          <!-- Password Check Container -->
          <div id="passwordCheck" style="display: none; flex-direction: column; align-items: center; margin-top: 15px;">
              <div class="setting-group" style="width: 100%;">
                  <div class="setting-label">
                      <i class="fas fa-key"></i> Confirm New Password
                  </div>
                  <div class="setting-input-container position-relative">
                      <input
                          type="password"
                          id="password-confirm"
                          class="setting-input pr-5"
                          placeholder="Enter current password"
                      >
                      <img 
                          src="/img/eye2.png" 
                          id="passwordConfirmToggleIcon" 
                          class="password-toggle-icon" 
                          onclick="togglePasswordConfirmVisibility()"
                      >
                      <button 
                          type="button" 
                          class="setting-edit-btn" 
                          onclick="confirmPassword()"
                      >
                          Confirm
                      </button>
                  </div>
              </div>
          </div>
          <button type="submit" class="setting-edit-btn">Save Changes</button>
        </form>
    </div>
    <script src="/setting.js"></script>
    <script src="/darkmode.js"></script>
    <script src="/background.js"></script>
  </body>
</html>
