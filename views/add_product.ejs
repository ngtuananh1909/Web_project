<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add Product</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
  <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <link rel="shortcut icon" href="#" />
  <link rel="stylesheet" href="/css/add-product.css">
  <link rel="stylesheet" href="/css/header.css">

</head>
  <body>
    <header class="header-design">
      <div class="container-fluid py-3 d-flex justify-content-between align-items-center">
        <div class="row w-100 d-flex justify-content-between align-items-center">
          <div class="col-md-4 col-6">
            <h1 class="h4 mb-0">
              <a href="/" class="text-decoration-none" style=" font-size: 40px;"><strong>E-Shop</strong></a>
            </h1>
          </div>
          <div class="col-md-4 col-12 d-none d-md-flex justify-content-center">
          </div>
          <div class="col-md-4 col-6">
            <nav class="nav justify-content-end">
              <ul class="nav d-flex align-items-center" style="gap: 10px; flex-wrap: nowrap;">
                <li class="nav-item me-1">
                  <a class="nav-link home" href="/">
                    <img src="/img/home.png" alt="home icon" class="home-icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <li class="nav-item me-1">
                  <a class="nav-link bxh" href="/scoreboard">
                    <img src="/img/bxh.jpg" alt="scoreboard icon" class="bxh-icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <% if (!user) { %>
                <li class="nav-item me-1">
                  <a class="nav-link login" href="/login">Đăng nhập</a>
                </li>
                <li class="nav-item me-1">
                  <a class="nav-link dangky" href="/register">Đăng ký</a>
                </li>
                <% } else { %>
                <li class="nav-item me-1">
                  <a class="nav-link giohang" href="/cart">
                    <img src="/img/cart.jpg" alt="cart icon" class="cart-icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <li class="nav-item me-1">
                  <a class="nav-link taosanpham" href="/product/add">
                    <img src="/img/add.jpg" alt="add product icon" class="add-icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <li class="nav-item dropdown" style="width: auto;">
                  <a class="nav-link dropdown-toggle d-flex align-items-center" id="userDropdown" role="button">
                    <% if (user.avatar) { %>
                    <img src="/<%= user.avatar %>" class="avatar me-1" alt="user avatar" style="width: 30px; height: 30px;" />
                    <% } else { %>
                    <img src="./img/def.jpg" class="avatar me-1" alt="" style="width: 30px; height: 30px;" />
                    <% } %>
                  </a>
                  <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                    <li>
                      <a class="dropdown-item" href="/user/<%= user.id %>">Profile</a>
                    </li>
                    <li><a class="dropdown-item" href="/settings">Cài đặt</a></li>
                    <li><a class="dropdown-item">Balanced: <%= user.balance %> VNĐ</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li class="nav-item">
                      <div class="d-flex align-items-center px-3 py-2">
                        <label class="change-mode" for="toggle-dark-mode" id="mode-label">Chế Độ Sáng</label>
                        <label class="switch">
                          <input type="checkbox" id="toggle-dark-mode">
                          <span class="slider round"></span>
                        </label>
                      </div>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" href="/logout">Đăng xuất</a></li>
                  </ul>
                </li>
                <% if (user.id == 'rgB6QoFkYk') { %>
                <li class="nav-item me-1">
                  <a class="nav-link taosanpham" href="/api/users">
                    <img src="/img/add.jpg" alt="admin icon" class="add-icon" style="width: 25px; height: 25px;">
                  </a>
                </li>
                <% } %>
                <% } %>
              </ul>
            </nav>
          </div>
        </div>
      </div>
    </header>
    <div class="table" >
      <div class="preview">
        <h2 class="alpha" style="text-align: center;">Product Preview</h2>
        <div class="card product-card class_preview">
          <img id="preview-image" class="card-img-top" src="" alt="Product Image">
          <div class="card-body info">
            <h3 id="preview-name" class="card-title alpha">Name</h3>
            <p id="preview-price" class="card-text alpha">Price: 0 VND</p>
            <p id="preview-quantity" class="card-text alpha">Quantity: 0</p>
            <p id="preview-sale" class="card-text alpha" style="display:none;">Sale Value: 0%</p>
            <p id="preview-description" class="card-text alpha">Decrision</p>
          </div>
        </div>
      </div>
      <div class="add">
        <h1>Add New Product</h1>
        <form id="product-form" action="/product/auth/add" method="POST" enctype="multipart/form-data" style="margin-top: 5%;">
          <div class="name_price" style="display: flex;background-color: transparent;gap: 20px;">
            <!-- Tên sản phẩm -->
            <input type="text" id="name" name="name" class="form-control button-input" style="border: 2px solid #7b7b7b; margin-bottom: 6%; width: 45%;" required placeholder="Product name">
        
            <!-- Giá sản phẩm -->
            <input type="number" id="price" name="price" class="form-control button-input" step="100" style="border: 2px solid #7b7b7b; width: 45%; margin-bottom: 6%;" required min="100" placeholder="Enter Price">
          </div>
          
      
          <div class="name_price" style="display: flex;background-color: transparent;gap: 20px;">
            <!-- Số lượng sản phẩm -->
            <input type="number" id="quantity" name="quantity" class="form-control button-input" style="border: 2px solid #7b7b7b; width: 45%; margin-bottom: 6%;" required min="1" placeholder="Enter quantity">
        
            <!-- Hình ảnh sản phẩm -->
            <input type="file" id="image" name="image" multiple class="form-control button-input" style="height: 50px; width: 45%; margin-bottom: 6%;" accept="image/*" required>
          </div>
      
          <!-- Sale checkbox -->
          <div class="form-check alpha" style="width: 100%; display: flex; align-items: right; margin-bottom: 6%;margin-left: 9%; background-color: transparent;">
            <input type="checkbox" id="sale" name="sale" class="form-check-input" style="margin-right: -50px;" onclick="toggleSaleValue()">
            <label for="sale" style="position: relative; display: inline-block; justify-content: center; width: 60px; height: 40px; border-radius: 5px; color: #1e1b1b; background-color: lightgray; text-align: center; cursor: pointer; font-size: 25px;">
              Sale
              <input type="checkbox" style="opacity: 0; position: absolute; width: 0%; height: 0%; cursor: pointer;">
            </label>
            <div class="form-group" id="sale-value-container" style="display: none; width: 100%; background-color: transparent;">
              <input type="number" id="saleval" name="saleval" class="form-control button-input" style="width: 100%;width: 100px; margin-bottom: -10%;margin-top: -2%;" min="1" max="99" step="1" placeholder="% Sale">
            </div>
          </div>
                
          <div class="form-group" style="width: 100%; margin-bottom: 6%;">
            <div id="editor"></div>
            <input type="hidden" id="description" name="description">
          </div>
      
          <button type="submit" class="btn btn-success button-submit" style="width: 100%; background-color: #2897f8;">Add Product</button>
        </form>
      </div>
      

      
      <div class="form-container " style="margin-left: 10px;">
        <h1>History</h1>
          <div class="history-group ">
              <name="history" class="form-control button-input" rows="4" required></textarea>
          </div>
      </div>

    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.slim.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>
    <script src="/preview.js"></script>
    <script src="/darkmode.js"></script>
    <script src="/sale.js"></script>
    <script src="/crop-image.js"></script>
  </body>
</html>
