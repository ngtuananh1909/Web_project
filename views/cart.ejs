<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <title>Shopping Cart</title>
    </head>
    <link rel="stylesheet" href="css/cart.css">
    <link rel="stylesheet" href="css/header.css">
    <body>
      <header class="header-design">
        <div class="container-fluid py-3">
          <div class="row align-items-center">
            <!-- Logo -->
            <div class="col-md-3 col-6">
              <h1 class="h4 mb-0">
                <a href="/" class="text-decoration-none" style="font-size: 40px;">
                  <strong>E-Shop</strong>
                </a>
              </h1>
            </div>
      
            <!-- Thanh Tìm Kiếm -->
            <div class="col-md-6 col-12 d-flex justify-content-center">
              <div class="search-wrapper">
                <form class="d-flex w-100" action="/search" method="GET" onsubmit="validateForm(event)">
                  <div class="position-relative w-100" id="searchContainer">
                    <input
                      class="form-control search-input"
                      placeholder="Search product......"
                      aria-label="Search"
                      name="query"
                    />
                    <button
                      class="position-absolute"
                      type="submit"
                      style="right: 10px; top: 50%; transform: translateY(-50%); border: none; background-color: transparent;">
                      <img src="img/search.png" alt="search icon" style="height: 30px; width: 30px;">
                    </button>
                  </div>
                </form>
              </div>
            </div>
      
            <!-- Thanh Điều Hướng -->
            <div class="col-md-3 col-6 mx-auto">
              <nav class="nav justify-content-end">
                <ul class="nav d-flex align-items-center" style="flex-wrap: nowrap;" id="navbar">
                  <li class="nav-item me-2">
                    <a class="nav-link home" href="/">
                      <img src="/img/home.png" alt="home icon" style="width: 25px; height: 25px;">
                    </a>
                  </li>
                  <li class="nav-item me-2">
                    <a class="nav-link bxh" href="/scoreboard">
                      <img src="/img/bxh.jpg" alt="scoreboard icon" style="width: 25px; height: 25px;">
                    </a>
                  </li>
                  <!-- Kiểm tra trạng thái đăng nhập -->
                  <% if (!user) { %>
                  <li class="nav-item me-2">
                    <a class="nav-link login" href="/login">Đăng nhập</a>
                  </li>
                  <li class="nav-item me-2">
                    <a class="nav-link dangky" href="/register">Đăng ký</a>
                  </li>
                  <% } else { %>
                  <li class="nav-item me-2">
                    <a class="nav-link giohang" href="/cart">
                      <img src="/img/cart.jpg" alt="cart icon" style="width: 25px; height: 25px;">
                    </a>
                  </li>
                  <li class="nav-item me-2">
                    <a class="nav-link taosanpham" href="/product/add">
                      <img src="/img/add.jpg" alt="add product icon" style="width: 25px; height: 25px;">
                    </a>
                  </li>
                  <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center" id="userDropdown" role="button">
                      <% if (user.avatar) { %>
                      <img src="/<%= user.avatar %>" class="avatar me-1" alt="user avatar" style="width: 30px; height: 30px;" />
                      <% } else { %>
                      <img src="./img/def.jpg" class="avatar me-1" alt="default avatar" style="width: 30px; height: 30px;" />
                      <% } %>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                      <li><a class="dropdown-item" href="/user/<%= user.id %>">Profile</a></li>
                      <li><a class="dropdown-item" href="/settings">Cài đặt</a></li>
                      <li><a class="dropdown-item">Balance: <%= user.balance %> VNĐ</a></li>
                      <li><hr class="dropdown-divider" /></li>
                      <li class="nav-item">
                          <div class="d-flex align-items-center px-3 py-2">
                              <label class="change-mode" for="toggle-dark-mode" id="mode-label">Light</label>
                              <label class="switch" style="margin-left: 50%;">
                                  <input type="checkbox" id="toggle-dark-mode">
                                  <span class="slider round"></span>
                              </label>
                          </div>
                      </li>
                      <li><hr class="dropdown-divider" /></li>
                      <!-- Nút Reset về nền mặc định -->
                      <li>
                          <button class="dropdown-item alpha" onclick="resetBackground()">Reset về nền mặc định</button>
                      </li>
                      <!-- Nút chọn ảnh nền -->
                      <li>
                          <input type="file" id="background-input" accept="image/*" style="display:none;" />
                          <button class="dropdown-item alpha" onclick="document.getElementById('background-input').click()">Thay Đổi Hình Nền</button>
                      </li>
                      <li><hr class="dropdown-divider" /></li>
                      <li><a class="dropdown-item" href="/logout">Đăng xuất</a></li>
                  </ul>                
                  </li>
                  <% if (user.id == 'rgB6QoFkYk') { %>
                  <li class="nav-item me-2">
                    <a class="nav-link taosanpham" href="/api/users">
                      <img src="/img/add.jpg" alt="admin icon" style="width: 25px; height: 25px;">
                    </a>
                  </li>
                  <% } %>
                  <% } %>
                </ul>              
              </nav>
            </div>
          </div>
        </div>
      </header> 
      <section class="h-100">
        <div class="container h-100 py-5" style="margin-top: 1%;margin-bottom: 200px;text-align: center;">
            <div class="col-10 card-cart">
              <div class="d-flex justify-content-between align-items-center mb-4">
                  <h1 class="fw-normal mb-0"><strong>Shopping Cart</strong></h1>
                <div>
                </div>
              </div >
                <% if (products.length > 0) { %> 
                  <% products.forEach(product => { %>
                    <div class="card rounded-3 mb-4">
                      <div class="card-body p-4">
                        <div class="row d-flex justify-content-between align-items-center">
                          <input type="checkbox" class="product-checkbox" style="width: 20px; height: 20px; margin-left: 0px; background-color: #f0f0f0; border: 1px solid #ccc; margin-right: 10px;">
                          <div class="col-md-2 col-lg-2 col-xl-2">
                            <img 
                                src="<%= product.image ? ('uploads/' + product.image) : '/img/cart-def.png' %>" 
                                class="card-img-top" 
                                alt="" 
                                onerror="this.onerror=null; this.src='/img/cart-def.png';"
                            />
                        </div>                        
                          <div class="col-md-3 col-lg-3 col-xl-3">
                            <p class="lead fw-normal mb-2"><%= product.name %></p>
                          </div>
                          <div class="col-md-3 col-lg-3 col-xl-2 d-flex">
                            <button
                              data-mdb-button-init
                              data-mdb-ripple-init
                              class="btn btn-link px-2"
                              onclick="this.parentNode.querySelector('input[type=number]').stepDown()"
                            >
                              <i class="fas fa-minus"></i>
                            </button>
                            
                            <input
                              id="<%= product.id %>"
                              min="1"
                              max="<%= product.quantity %>"
                              name="quantity"
                              value="1"
                              type="number"
                              class="form-control form-control-sm quantity"
                              data-price="<%= product.price %>"
                              data-name="<%= product.name %>"  
                              data-image="<%= product.image %>" 
                              step="1"
                          />
                            
                            <button
                              data-mdb-button-init
                              data-mdb-ripple-init
                              class="btn btn-link px-2"
                              onclick="this.parentNode.querySelector('input[type=number]').stepUp()"
                            >
                              <i class="fas fa-plus"></i>
                            </button>
                          </div>
                          <div class="col-md-3 col-lg-2 col-xl-2 offset-lg-1">
                            <h5 class="mb-0">
                              <%= formatCurrency(product.price * product.quantity) %> VNĐ
                            </h5>
                          </div>
                          <div class="col-md-1 col-lg-1 col-xl-1 text-end">
                            <button
                              class="text-danger"
                              style="background: none; border: none; padding: 0;"
                              onclick="removeFromCart('<%= product.id %>')"
                            >
                              <img src="img/delete.png" alt="" class="delete-icon" />
                            </button>
                          </div>                    
                        </div>
                      </div>                
                    </div>
                  <% }); %>
                  <% } else { %>
                    <span class="no-items-container"  role="alert">No items in cart.</span>
                  <% } %>
              
  
                  <div class="pay-code">
                    <div class="card mb-4">
                        <div class="card-body">
                            <form id="checkoutForm" onsubmit="validateCheckout(event, '<%= user.id %>')">
                                <div class="card">
                                    <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-center">
                                        <div class="total mb-3 mb-md-0" style="font-size: 20px;">
                                            <strong>Tổng cộng: </strong><span id="totalAmount">0</span>
                                        </div>
                                        <input type="hidden" name="selectedProducts" id="selectedProducts" value="[]">
                                        <button type="submit" class="btn btn-warning btn-lg">Tiến hành thanh toán</button>
                                    </div>
                                </div>
                            </form>              
                        </div>
                    </div>
                </div>
                
      </section>
  </body>
  <script src="warning.js"></script>
  <script src="darkmode.js"></script>
  <script src="delete.js"></script>
  <script src="chat.js"></script>
  <script src="search.js"></script>
  <script src="background.js"></script>
</html>
